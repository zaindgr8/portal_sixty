# ───────── Core ─────────
# Supabase project shared by every module (chats, WhatsApp leads, call leads, campaigns, users).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=
# Random string that signs sign-in sessions (openssl rand -hex 32). Changing it signs everyone out.
SESSION_SECRET=
# Encrypts each client workspace's saved API keys (openssl rand -hex 32). Defaults to one derived from
# SESSION_SECRET; set it explicitly so you can rotate SESSION_SECRET without losing saved keys.
CREDENTIALS_KEY=
# Public sign-up at /signup (new workspaces wait for approval in the Admin console). Set to false for invite-only.
# SIGNUP_ENABLED=true
# Optional emergency login used only if the app_users table is missing or unreachable.
# BOOTSTRAP_USERNAME=
# BOOTSTRAP_PASSWORD=

# ───────── AI (both modules): Google Gemini ─────────
# Lead scoring, WhatsApp AI replies/drafts and call lead briefs. Google AI Studio → Get API key.
GEMINI_API_KEY=
# Model for scoring and call briefs (default gemini-3.5-flash). WhatsApp replies pick their model on the Agent page.
# GEMINI_MODEL=gemini-3.5-flash

# ───────── WhatsApp (Twilio) ─────────
# These are the PRIMARY workspace's keys. Other client workspaces save theirs in Workspace settings → Connections.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_MESSAGING_SERVICE_SID=
# Public URL of this app (ngrok locally, your domain in production). Must match the Twilio webhook URL.
PUBLIC_BASE_URL=
# Optional: your n8n WhatsApp workflow webhook
N8N_WEBHOOK_URL=

# ───────── Voice calls (Retell AI) ─────────
# Primary workspace only; other workspaces save their Retell key in Workspace settings → Connections.
RETELL_API_KEY=
RETELL_SECRET_KEY=
# Optional: limit the Calls module to specific agents (comma-separated agent IDs)
ALLOWED_AGENT_IDS=


# ───────── Instagram (one Meta app for every workspace) ─────────
# Meta app → Instagram → API setup with Instagram login → Instagram app ID / secret.
# Each workspace then clicks "Connect Instagram" in Workspace settings → Connections.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional: Graph API version (default v23.0).
# INSTAGRAM_GRAPH_VERSION=v23.0

# WhatsApp number clients reach for setup help ("Book setup call" on Get started), e.g. 9715XXXXXXXX.
# Without it those buttons open an email to management@devmatesolutions.com.
# NEXT_PUBLIC_SUPPORT_WHATSAPP=

# ───────── WhatsApp via Meta (Embedded Signup + Cloud API) ─────────
# The same Meta app as Instagram ("Sixty by DevMate"): App settings → Basic → App ID / App secret
# (the main app's, not the Instagram app's). Clients click "Connect WhatsApp" in Workspace settings.
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business → Configurations → your WhatsApp Embedded Signup configuration ID.
META_ES_CONFIG_ID=
# Optional: Graph API version (default v23.0).
# META_GRAPH_VERSION=v23.0

# ───────── Ask Sixty (in-portal AI assistant) ─────────
# Optional separate Gemini key for the assistant; falls back to GEMINI_API_KEY. Use a PAID-tier key:
# on the free tier Google may use prompts and chat data to improve its models.
# ASSISTANT_GEMINI_API_KEY=
# ASSISTANT_GEMINI_MODEL=gemini-3.8-flash

# ───────── PropTech · Auto Listing (agencies with the proptech_auto_listing feature) ─────────
# Uses GEMINI_API_KEY (paid tier: Form A has owner personal data). Flash does extraction, photos and English copy;
# Pro writes the Arabic copy. Defaults: gemini-3.8-flash / gemini-3.1-pro-preview.
# GEMINI_MODEL_PRO=gemini-3.1-pro-preview
# Override Gemini prices (USD per 1M tokens) used for the AI cost per listing, e.g. {"gemini-3.8-flash":{"in":1.5,"out":7.5}}
# GEMINI_PRICES=
# Private Supabase Storage bucket for uploads (created by supabase/proptech.sql).
# PROPTECH_BUCKET=proptech
# Background jobs run inside the web server. Set to "off" on extra instances if you only want one worker.
# PROPTECH_WORKER=on
# PROPTECH_JOB_CONCURRENCY=3
