        "property_type": { "labels": ["property type", "type"], "options": { "apartment": ["Apartment"], "villa": ["Villa"], "townhouse": ["Townhouse"], "penthouse": ["Penthouse"], "duplex": ["Duplex"], "hotel_apartment": ["Hotel Apartment"], "land": ["Residential Plot", "Plot", "Land"], "office": ["Office"], "retail": ["Shop", "Retail"], "warehouse": ["Warehouse"], "full_building": ["Building", "Residential Building"], "bulk_units": ["Bulk Units"] } },
        "completion_status": { "labels": ["completion status", "completion"], "options": { "ready": ["Ready", "Completed"], "off_plan": ["Off-Plan", "Off plan"] } },
        "community": { "labels": ["location", "locality", "area"] },
        "building": { "labels": ["building", "tower", "sub-locality"] },
