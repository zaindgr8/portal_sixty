        "cheques": { "labels": ["cheques", "number of cheques"] },
        "furnishing": { "labels": ["furnishing", "furnished"], "options": { "furnished": ["Furnished", "Yes"], "semi_furnished": ["Partly", "Semi-furnished"], "unfurnished": ["Unfurnished", "No"] } },
        "parking": { "labels": ["parking", "parking spaces"] },
        "floor": { "labels": ["floor"] },
        "developer": { "labels": ["developer"] },
        "permit_number": { "labels": ["permit number", "trakheesi", "dld permit", "permit"] },
        "title_en": { "labels": ["title", "property title", "title (english)"] },
        "description_en": { "labels": ["description", "property description", "description (english)"] },
        "title_ar": { "labels": ["title (arabic)", "arabic title", "العنوان"] },
        "description_ar": { "labels": ["description (arabic)", "arabic description", "الوصف"] },
        "agent_brn": { "labels": ["brn", "agent brn"] },
        "reference": { "labels": ["reference", "ref no", "reference number"] }
      }
